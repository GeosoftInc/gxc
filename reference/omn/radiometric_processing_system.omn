/
/ Airborne Spectrometer Data Processing System menu
/
/------------------------------------------------------------------------------

MENU "&RPS"
ITEM "&Smooth Spectra..."           ,geogxnet.dll(Geosoft.GX.Radiometrics.SmoothSpectra;Run)
ITEM "&Generate Radioelement Counts...",geogxnet.dll(Geosoft.GX.Radiometrics.GenerateRadioelementCounts;Run)
SEPARATOR
ITEM "&Calculate STP Elevation..."  ,geogxnet.dll(Geosoft.GX.Radiometrics.CalculateSTPElevation;Run)
SEPARATOR
ITEM "&Account for Dead Time..."    ,geogxnet.dll(Geosoft.GX.Radiometrics.AccountForDeadTime;Run)
ITEM "&Along-Line Filtering..."     ,geogxnet.dll(Geosoft.GX.Radiometrics.AlongLineFiltering;Run)
ITEM "&Remove Aircraft and Cosmic Effects..."   ,geogxnet.dll(Geosoft.GX.Radiometrics.RemoveAircraftAndCosmicEffects;Run)
ITEM "&Remove Radon Effect..."      ,geogxnet.dll(Geosoft.GX.Radiometrics.RemoveRadonEffect;Run)
ITEM "&Compton Stripping..."        ,geogxnet.dll(Geosoft.GX.Radiometrics.ComptonStripping;Run)
ITEM "&Height Correction..."        ,geogxnet.dll(Geosoft.GX.Radiometrics.HeightCorrection;Run)
SEPARATOR
ITEM "&Generate Radioelement Concentrations..."   ,geogxnet.dll(Geosoft.GX.Radiometrics.GenerateRadioelementConcentrations;Run)
ITEM "&Generate Radioelement Ratios..."  ,geogxnet.dll(Geosoft.GX.Radiometrics.GenerateRadioelementRatios;Run)
SUBMENU "&Plotting"
SUBMENU "&Utilities"

MENU "&RPS/&Plotting"
ITEM  "&Grid Data..."               ,geogxnet.dll(Geosoft.GX.GridUtils.GriddingTool;Run)
ITEM  "&Display Grid..."	 			,geogxnet.dll(Geosoft.GX.GridUtils.DisplayGrid;Run)  
ITEM  "&Draw Base Map..."           ,basemap2.gx          {?map_not_3dv}
ITEM  "&Ternary Image..."           ,gridimgt.gx
ITEM  "Ternary &Legend..."          ,ternleg.gx

MENU "&RPS/&Utilities"
ITEM "&Compress Energy Spectrum...",geogxnet.dll(Geosoft.GX.Radiometrics.CompressArray;Run)
ITEM "&View Coincident Arrays..."	,geogxnet.dll(Geosoft.GX.EM.MultipleArrayChannelProfileViewer;RunForRPS)