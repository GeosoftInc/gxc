//-----------------------------------------------------------------------------------------------------------
// WindowSpectrumToChannel_RPS Window radiometric data channel on a line in a database
//
// Notes                       The average value of the windows in the given fractional index range is 
//                             written to the specified output channel.
//                             For instance, if you specified 0.5 to 1.5, then half values in the first
//                             window would be added to half the values in the second window. To specify
//                             a single window 'i' you need to specify the range i to i+1.
//                             
//                             Ref:  See the RPSWINDOW.GXC file for details and implementation of the algorithm.
//
// Available                   2025.2
//-----------------------------------------------------------------------------------------------------------

[_licensed] void WindowSpectrumToChannel_RPS(DB,       // DB Object
                                             int,      // Line to process (NULLSYMB for all selected lines)
                                             int,      // Spectral data channel handle (READONLY)
                                             real,     // Starting fractional window index (0 to N)
                                             real,     // Ending fractional window index (0 to N), >= Starting window
                                             int,      // Output channel handle (READWRITE)
                                             string);  // Output channel description for output/errors etc


  
