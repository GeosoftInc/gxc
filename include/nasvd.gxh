                                           var int);  // (out) Total number of channels, including (head + data + tail).



//===========================================================================================================
//
// Reconstruction Functions
//
//===========================================================================================================


  
//-----------------------------------------------------------------------------------------------------------
// ReconstructSpectrum_NASVD Reconstruct spectral data using selected components
//
// Notes                     Performs spectral reconstruction using only the first N eigenvectors/components.
//                           This effectively filters the data by removing noise associated with higher-order
//                           components while preserving the signal in the dominant components.
//                           
//                           The reconstructed data is written to the specified output channel on all lines used
//                           to create the NASVD object originally (see NASVD::Create, for more details).
//
// Available                 2025.2
//-----------------------------------------------------------------------------------------------------------

[_licensed] void ReconstructSpectrum_NASVD(NASVD,    // NASVD Object
                                           DB,       // DB Object
                                           int,      // Number of leading components to use for reconstruction
                                           string);  // Output channel name for reconstructed spectral data



