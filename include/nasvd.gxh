//
// Utilities Functions
//
//===========================================================================================================


  
//-----------------------------------------------------------------------------------------------------------
// GetCumulativeEigenvectorContribution_NASVD Calculate the variance explained by each component
//
// Notes                                      Calculates cumulative eigenvector contribution percentages  for each component 
//                                            based on their singular values. This helps determine how many components
//                                            are needed to achieve a desired level of accuracy in the reconstruction.
//
// Available                                  2025.2
//-----------------------------------------------------------------------------------------------------------

[_licensed] void GetCumulativeEigenvectorContribution_NASVD(NASVD,   // NASVD Object
                                                            VV);     // VV to receive cumulative eigenvector contribution percentages


  
//-----------------------------------------------------------------------------------------------------------
// GetMaximumElementCount_NASVD Get the maximum number of elements that can be processed by NASVD
//
// Notes                        Returns the maximum number of elements that can be processed
//                              by the NASVD algorithm to avoid memory allocation failures. This
//                              value is stored as an advanced setting in Oasis montaj.
//
// Available                    2025.2
//-----------------------------------------------------------------------------------------------------------

[_licensed] void GetMaximumElementCount_NASVD(var int);  // Maximum number of elements (rows * columns) that can be processed by NASVD



